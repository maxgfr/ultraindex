{
  "name": "ultraindex",
  "version": "7.4.0",
  "description": "The verified knowledge layer over codeindex: an AI writes a durable, per-module encyclopedia of what a repo MEANS, every sentence cites real source, and mechanical gates reject any citation that does not resolve. A skills.sh agent skill. Keyless, zero deps.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "ultraindex": "scripts/ultraindex.mjs"
  },
  "files": [
    "scripts",
    "src",
    "skills",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-bundle.mjs",
    "grammars": "node scripts/provision-grammars.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:build": "node scripts/sync-engine.mjs --check && tsup && node scripts/copy-bundle.mjs && git diff --exit-code -- scripts/ultraindex.mjs skills/ultraindex/scripts/ultraindex.mjs",
    "demo": "node scripts/ultraindex.mjs build --repo tests/fixtures/mini-repo --out /tmp/ultraindex-demo && node scripts/ultraindex.mjs check --repo tests/fixtures/mini-repo --out /tmp/ultraindex-demo",
    "release": "semantic-release"
  },
  "keywords": [
    "skills",
    "agent-skill",
    "skills.sh",
    "code-index",
    "codeindex",
    "knowledge-graph",
    "grounding",
    "citations",
    "documentation",
    "encyclopedia",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "maxgfr",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxgfr/ultraindex"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^20.14.0",
    "semantic-release": "^24.2.0",
    "tree-sitter-c": "^0.24.1",
    "tree-sitter-c-sharp": "^0.23.5",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "web-tree-sitter": "^0.26.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
